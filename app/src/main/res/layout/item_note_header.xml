<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingTop="16dp"
    android:paddingBottom="6dp">

    <!-- Subject Code Badge -->
    <TextView
        android:id="@+id/tvHeaderSubjectCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_round"
        android:backgroundTint="@color/black"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:text="CS303"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Course / Subject Full Name -->
    <TextView
        android:id="@+id/tvHeaderCourseName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Operating System"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Notes Count Badge in this subject group -->
    <TextView
        android:id="@+id/tvHeaderNotesCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_round"
        android:backgroundTint="#F2F2F2"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="2 Notes"
        android:textColor="@color/gray_dark"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
